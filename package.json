{
  "name": "ds2-eva3",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env -- pnpm --parallel --filter backend --filter frontend dev",
    "dev:backend": "dotenv -e .env -- pnpm --filter backend dev",
    "dev:frontend": "dotenv -e .env -- pnpm --filter frontend dev",
    "build": "dotenv -e .env -- pnpm --filter backend build && pnpm --filter frontend build",
    "build:backend": "dotenv -e .env -- pnpm --filter backend build",
    "build:frontend": "dotenv -e .env -- pnpm --filter frontend build",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "start": "./start.sh"
  },
  "packageManager": "pnpm@11.25.0",
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.23.13"
  }
}
