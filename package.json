{
  "name": "ds2-eva3",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter backend --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "pnpm --filter backend build && pnpm --filter frontend build",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:migrate": "dotenv -e .env -- pnpm --filter backend prisma:migrate:dev",
    "db:deploy": "dotenv -e .env -- pnpm --filter backend prisma:migrate",
    "db:push": "dotenv -e .env -- pnpm --filter backend prisma:push",
    "db:seed": "dotenv -e .env -- pnpm --filter backend prisma:seed",
    "db:studio": "dotenv -e .env -- pnpm --filter backend prisma:studio",
    "start": "./start.sh"
  },
  "packageManager": "pnpm@11.25.0",
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "prisma": "5.22.0"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  }
}
